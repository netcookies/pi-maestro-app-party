{
  "name": "@maestro-mobile/shared",
  "version": "0.9.6",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm --filter @maestro-mobile/mobile-sdk build && tsc",
    "typecheck": "pnpm --filter @maestro-mobile/mobile-sdk build && tsc --noEmit",
    "test": "pnpm --filter @maestro-mobile/mobile-sdk build && vitest run",
    "test:coverage": "pnpm --filter @maestro-mobile/mobile-sdk build && vitest run --coverage",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@maestro-mobile/mobile-sdk": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^4.1.0"
  },
  "description": "Maestro Mobile Shared — 协议与类型",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/netcookies/pi-maestro-app-party.git"
  }
}
