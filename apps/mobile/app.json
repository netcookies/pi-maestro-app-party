{
  "expo": {
    "name": "Maestro Mobile",
    "slug": "maestro-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#0d1117",
      "resizeMode": "contain"
    },
    "ios": {
      "bundleIdentifier": "dev.maestromobile.app",
      "supportsTablet": true,
      "buildNumber": "1",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "dev.maestromobile.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0d1117"
      }
    },
    "scheme": "maestro-mobile",
    "plugins": [
      "expo-router"
    ]
  }
}