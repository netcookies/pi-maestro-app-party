{
  "name": "@maestro-mobile/app",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev": "expo start",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "build:android": "expo prebuild --platform android && cd android && ./gradlew assembleDebug",
    "build:ios": "expo prebuild --platform ios && cd ios && pod install && xcodebuild -workspace MaestroMobile.xcworkspace -scheme MaestroMobile -configuration Debug -sdk iphonesimulator -derivedDataPath build"
  },
  "dependencies": {
    "@maestro-mobile/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@ronradtke/react-native-markdown-display": "9.0.3",
    "expo": "~53.0.0",
    "expo-camera": "~16.1.0",
    "expo-clipboard": "~7.1.3",
    "expo-constants": "~17.1.8",
    "expo-document-picker": "^13.1.6",
    "expo-image-picker": "^16.1.4",
    "expo-linking": "~7.1.7",
    "expo-router": "~5.1.11",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "^15.11.2"
  },
  "devDependencies": {
    "@types/react": "~19.0.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.0"
  },
  "description": "Maestro Mobile App — 移动端（Expo / React Native）",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/netcookies/pi-maestro-app-party.git"
  }
}
