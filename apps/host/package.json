{
  "name": "@maestro-mobile/host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js"
  },
  "bin": {
    "maestro-mobile-host": "./dist/cli.js"
  },
  "dependencies": {
    "@maestro-mobile/shared": "workspace:*",
    "@earendil-works/pi-coding-agent": "^0.79.0",
    "ws": "^8.18.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.0"
  },
  "description": "Maestro Mobile Host — PC 端 SDK Host（Pi agent 会话 + maestro 状态投影 + WS 服务）",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isulewli/pi-maestro-app-party.git"
  }
}
